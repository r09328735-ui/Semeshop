// ============================================================================
// SemevoShop — Prisma schema
// MongoDB + Prisma ORM
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ============================================================================
// AUTH (NextAuth.js)
// ============================================================================

model User {
  id            String    @id @default(cuid()) @map("_id")
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // bcrypt hash; null for OAuth-only accounts
  phone         String?
  image         String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true) // false = blocked by admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
  cartItems CartItem[]
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// ADDRESSES
// ============================================================================

model Address {
  id         String      @id @default(cuid()) @map("_id")
  userId     String
  type       AddressType
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsShipping Order[] @relation("ShippingAddress")
  ordersAsBilling  Order[] @relation("BillingAddress")

  @@index([userId])
}

// ============================================================================
// CATALOG
// ============================================================================

model Category {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  slug        String   @unique
  description String?
  image       String?
  position    Int      @default(0)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?         @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[]        @relation("CategoryToCategory")
  products ProductCategory[]

  @@index([parentId])
}

model Product {
  id                String        @id @default(cuid()) @map("_id")
  name              String
  slug              String        @unique
  description       String // rich text (HTML from Tiptap)
  price             Float
  compareAtPrice    Float?
  sku               String        @unique
  stock             Int           @default(0)
  lowStockThreshold Int           @default(5)
  weight            Float? // kg
  length            Float? // cm
  width             Float?
  height            Float?
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  avgRating         Float         @default(0)
  reviewCount       Int           @default(0)
  salesCount        Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  categories ProductCategory[]
  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  wishlist   WishlistItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([status])
  @@index([name])
}

model ProductCategory {
  id         String @id @default(cuid()) @map("_id")
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid()) @map("_id")
  productId String
  url       String // /api/media/<MediaAsset id>, stored in MongoDB
  alt       String?
  position  Int     @default(0)
  isMain    Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String  @id @default(cuid()) @map("_id")
  productId     String
  size          String?
  color         String?
  sku           String  @unique
  stock         Int     @default(0)
  priceModifier Float   @default(0) // added to base price

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ============================================================================
// MEDIA (images stored directly in MongoDB)
// ============================================================================

model MediaAsset {
  id          String   @id @default(cuid()) @map("_id")
  data        Bytes
  contentType String
  filename    String?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id          String       @id @default(cuid()) @map("_id")
  productId   String
  userId      String
  orderItemId String?      @unique // links review to a verified purchase
  rating      Int // 1-5
  title       String?
  comment     String
  images      String[]     @default([])
  status      ReviewStatus @default(PENDING)
  adminReply  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem[]

  @@index([productId])
  @@index([userId])
  @@index([status])
}

// ============================================================================
// WISHLIST / CART
// ============================================================================

model WishlistItem {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CartItem {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId, variantId])
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id            String        @id @default(cuid()) @map("_id")
  orderNumber   String        @unique
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(PENDING) // PENDING = à payer à la livraison

  subtotal       Float
  shippingCost   Float @default(0)
  taxAmount      Float @default(0)
  discountAmount Float @default(0)
  total          Float

  couponId          String?
  shippingAddressId String
  billingAddressId  String
  shippingMethodId  String?

  trackingNumber String?
  carrier        String?
  notes          String?

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  shippingAddress Address              @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address              @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingMethod  ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coupon          Coupon?              @relation(fields: [couponId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid()) @map("_id")
  orderId   String
  productId String
  variantId String?

  // snapshots at time of purchase (product may change/be deleted later)
  name     String
  image    String?
  sku      String
  price    Float
  quantity Int

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review   Review?         @relation(fields: [reviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewId String?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid()) @map("_id")
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ============================================================================
// PROMOTIONS
// ============================================================================

model Coupon {
  id          String       @id @default(cuid()) @map("_id")
  code        String       @unique
  type        DiscountType
  value       Float
  minPurchase Float?
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders Order[]
}

// ============================================================================
// SHIPPING & TAX
// ============================================================================

model ShippingZone {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  countries String[] // ISO country codes
  createdAt DateTime @default(now())

  methods ShippingMethod[]
}

model ShippingMethod {
  id               String  @id @default(cuid()) @map("_id")
  shippingZoneId   String
  name             String
  description      String?
  cost             Float
  estimatedDaysMin Int
  estimatedDaysMax Int
  isActive         Boolean @default(true)

  zone   ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([shippingZoneId])
}

model TaxRate {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  country   String
  state     String?
  rate      Float // percentage
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================================
// STORE SETTINGS (singleton) & CONTACT
// ============================================================================

model StoreSettings {
  id                    String   @id @default(cuid()) @map("_id")
  name                  String   @default("SemevoShop")
  logo                  String?
  email                 String?
  phone                 String?
  whatsappNumber        String? // international format, digits only, e.g. "22966623182"
  address               String?
  facebookUrl           String?
  instagramUrl          String?
  twitterUrl            String?
  currency              String   @default("XOF")
  freeShippingThreshold Float?
  updatedAt             DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
