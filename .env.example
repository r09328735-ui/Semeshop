# ============================================================================
# SemevoShop — variables d'environnement
# Copiez ce fichier en .env et renseignez les valeurs réelles.
# ============================================================================

# --- Base de données (MongoDB) ---
# Chaîne de connexion MongoDB Atlas (ou une autre instance MongoDB).
# Doit inclure le nom de la base après le nom d'hôte, ex: .../semevoshop
DATABASE_URL="mongodb+srv://Marc-Rosaire:Marcrosaire%40yikou%C3%A9@cluster0.jwckuzr.mongodmongodb+srv://Marc-Rosaire:Marcrosaire%40yikou%C3%A9@cluster0.jwckuzr.mongodb.netb.net/ SemevoShop?retryWrites=true&w=majority

# --- NextAuth.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # générer avec: openssl rand -base64 32

# --- Google OAuth (optionnel) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Rate limiting (Upstash Redis, optionnel mais recommandé en prod) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Remarques :
# - Aucun paiement en ligne : les commandes sont payées à la livraison.
# - Aucun email n'est envoyé par l'application : le contact client se fait
#   via WhatsApp (numéro configurable dans les paramètres de la boutique,
#   espace admin). Aucune variable d'environnement n'est donc nécessaire
#   pour Stripe, Cloudinary ou l'envoi d'emails.
