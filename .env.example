# ============================================================================
# Semeshop — variables d'environnement
# Copiez ce fichier en .env et renseignez les valeurs réelles.
# ============================================================================

# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/semeshop?schema=public"

# --- NextAuth.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # générer avec: openssl rand -base64 32

# --- Google OAuth (optionnel) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe (mode test) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Emails (Resend) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="Semeshop <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@semeshop.com"

# --- Rate limiting (Upstash Redis, optionnel mais recommandé en prod) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
